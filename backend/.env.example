# ============================================================
# SkillSync AI — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# ── Server ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development         # development | production | test

# ── PostgreSQL / NeonDB ───────────────────────────────────
# Get these from: https://console.neon.tech → Your Project → Connection Details
#
# DATABASE_URL    — used for all Prisma queries (can be a pooled connection)
# DIRECT_URL      — used ONLY for Prisma migrations (must be a direct, non-pooled connection)
#
# Copy these VERBATIM from the Neon console. Note the `c-<N>` cluster label — omitting it
# routes to the wrong Neon proxy, which fails with a misleading "password authentication
# failed". Never substitute a raw IP address for the hostname: Neon rotates those IPs and
# the deploy will break the moment it happens.
#
# NeonDB pooled endpoint (for production queries — uses PgBouncer):
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.c-2.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
#
# NeonDB direct endpoint (for migrations only):
DIRECT_URL="postgresql://USER:PASSWORD@ep-XXXX.c-2.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
#
# For local development with Docker Postgres:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skillsync?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/skillsync?schema=public"
#
# For running tests (separate test database):
DATABASE_TEST_URL="postgresql://USER:PASSWORD@ep-XXXX.c-2.REGION.aws.neon.tech/skillsync_test?sslmode=require&connect_timeout=15"

# ── JWT ────────────────────────────────────────────────────
# Generate a strong secret: `openssl rand -hex 64`
JWT_SECRET=your_very_long_random_jwt_secret_here_at_least_64_chars
JWT_EXPIRES_IN=24h

# ── AI Providers ───────────────────────────────────────────
# Supported values: groq | gemini | openai | anthropic
AI_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── CORS ───────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Email (Resend) ─────────────────────────────────────────
# Get RESEND_API_KEY from: https://resend.com → sign up → Dashboard → API Keys → Create API Key
# EMAIL_FROM must be an address on a domain you've verified in Resend
# (Dashboard → Domains). Until you verify a domain, Resend's sandbox sender
# "onboarding@resend.dev" works but can only deliver to the email address
# you signed up to Resend with — fine for local dev, not for real users.
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="SkillSync AI <onboarding@resend.dev>"

# ── File Uploads ───────────────────────────────────────────
# Absolute path to uploads directory (defaults to backend/uploads/)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# ── Google OAuth ───────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id_here

